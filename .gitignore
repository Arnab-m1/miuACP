# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.obj
*.lib

# CMake build directories
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
# Ignore Makefiles generated by CMake, but keep root Makefile
build/Makefile
cmake-build-*/Makefile
*.cmake
!cmake/*.cmake

# Debug and test executables (not source files)
debug_boundary
debug_test
test_response
*_test
*_test.exe

# Debug source files (temporary test files in root)
debug_*.cpp
test_response.cpp

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Compiler output
*.d
*.gcda
*.gcno
*.gcov

# Coverage reports
coverage/
*.gcov
*.info

# Documentation builds
docs/_build/
docs/html/
docs/latex/

# Temporary files
*.tmp
*.bak
*.log
*.cache

# Python (if any scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
miuACP-Lib/

# Backup files
*.orig
*.rej

